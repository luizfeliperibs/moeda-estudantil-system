        bigint usuario_id PK
        varchar nome
        varchar cpf UK
        varchar departamento
        int saldo
        bigint instituicao_id FK
    }
    EMPRESA_PARCEIRA {
        bigint usuario_id PK
        varchar nome
        varchar cnpj UK
        varchar email
    }
    VANTAGEM {
        bigint id PK
        bigint empresa_id FK
        varchar nome
        varchar descricao
        varchar foto_url
        int custo_moedas
    }
    TRANSACAO {
        bigint id PK
        timestamp data_hora
